# Solo el servidor usa estas variables. Pega la clave real únicamente en .env.
GEMINI_API_KEY=
# Modelo verificado con llamadas reales en el paso 8.
GEMINI_MODEL=gemini-3.5-flash-lite
# Generar un secreto aleatorio de al menos 32 caracteres, solo en el servidor.
AUTH_SESSION_SECRET=
# Solo desarrollo local. Vercel exige Redis compartido; nunca usa este archivo local.
QUOTA_DRIVER=local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
