{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "src",
  "installCommand": "npm ci",
  "buildCommand": "",
  "devCommand": "",
  "functions": {
    "api/functions.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/((?!api(?:/|$)|_vercel(?:/|$)|.*\\.).*)", "destination": "/index.html" }
  ]
}
